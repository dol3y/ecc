<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title or site.title) + (" · " + site.title if title else "") %}
  {%- set pageDescription = description or site.tagline %}
  {%- set canonicalUrl = site.baseUrl + (page.url | url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/images/ecc-logo.svg' | url }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__bar">
      <a class="site-header__brand" href="{{ '/' | url }}">
        <img class="site-header__logo" src="{{ '/images/ecc-logo.svg' | url }}" alt="{{ site.title }} logo" width="56" height="56">
      </a>

      <ul class="menu-bar">
        {% for item in site.nav %}
          <li>
            {% if item.href %}
              <a href="{{ item.href if item.external else (item.href | url) }}">{{ item.label }}</a>
            {% else %}
              <span class="menu-bar__soon" title="Coming soon">{{ item.label }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      <details class="nav-toggle">
        <summary class="nav-toggle__button" aria-label="Menu">
          <span></span><span></span><span></span>
        </summary>
        {% include "partials/nav.njk" %}
      </details>
    </div>
  </header>

  <main id="main" class="page">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>&copy; {{ site.buildDate | formatDate("yyyy") }} {{ site.title }}.</p>
      <p class="site-footer__meta">Site last built {{ site.buildDate | formatDate("d LLLL yyyy") }}.</p>
      <p>This site does not use
        <a href="https://en.wikipedia.org/wiki/HTTP_cookie" target="_blank" rel="noopener">cookies</a>, and we
        do not track or save visitors' data.</p>
    </div>
  </footer>
</body>
</html>
